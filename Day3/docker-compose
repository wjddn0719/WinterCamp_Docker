version: '3.8'
services:
  rag_server:
    build:
      context: ./rag_server
      dockerfile: Dockerfile
    container_name: rag_server
    ports:
      - "7777:7777"
    networks:
      - rag-network
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: backend
    ports:
      - "8000:8000"
    networks:
      - rag-network
networks:
  rag-network:
    external: true